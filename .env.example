# Copy the values in with `npm run setup:env` (hidden prompts) rather than by hand.
# .env.local is git-ignored. Never put a secret under a VITE_ name: those are built into the browser app.

# Browser (public by design)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Server only (local API server and Vercel functions)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot (optional): set with `npm run setup:env`. The token is a secret; the username is public.
# TELEGRAM_BOT_TOKEN=123456789:...
# TELEGRAM_WEBHOOK_SECRET=made by `npm run setup:env`, at least 32 characters
# VITE_TELEGRAM_BOT_USERNAME=farmsafe_records_bot

# Optional
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_RATE_LIMIT_PER_MIN=20
# AI_RATE_LIMIT_PER_DAY=200
# AI_RATE_LIMIT_GLOBAL_PER_DAY=5000
# ALLOWED_ORIGINS=https://your-other-site.example
# AGENT_MODEL=claude-sonnet-5-5
# AGENT_RATE_LIMIT_PER_DAY=100
# VITE_CAPTCHA_PROVIDER=turnstile
# VITE_CAPTCHA_SITE_KEY=...
